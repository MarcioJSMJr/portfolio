# Conexão com o banco de dados PostgreSQL (Supabase)
# DATABASE_URL: Conexão através do Transaction Pooler (porta 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Conexão direta com o banco para migrações e comandos do Prisma (porta 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Senha mestra de acesso ao Painel Administrativo (/admin)
ADMIN_PASSWORD="admin123"
